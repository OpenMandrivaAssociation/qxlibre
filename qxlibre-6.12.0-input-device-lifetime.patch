From aea025fc690d1110b4100a0dee3c5e3d6ab90993 Mon Sep 17 00:00:00 2001
From: Joseph Crowell <joseph.w.crowell@gmail.com>
Date: Mon, 9 Nov 2026 13:22:44 +1000
Subject: [PATCH 2/2] Don't delete slave input devices twice

A removed master's slaves are its children, so deleting the master and
then the slaves freed them twice, crashing every Qt application when an
X master device was removed.

Signed-off-by: Joseph Crowell <joseph.w.crowell@gmail.com>
---
 RELEASE-NOTES.md                              |  3 ++
 .../platforms/xcb/qxcbconnection_xi2.cpp      |  5 +++
 tests/auto/inputdevices/tst_inputdevices.cpp  | 39 ++++++++++++++++++-
 3 files changed, 45 insertions(+), 2 deletions(-)

diff --git a/RELEASE-NOTES.md b/RELEASE-NOTES.md
index 900bba4..bd73a14 100644
--- a/RELEASE-NOTES.md
+++ b/RELEASE-NOTES.md
@@ -21,6 +21,9 @@ support in Qt, and it keeps working if Qt removes that support. These notes list
   paste, or by sending more than 2 GiB.
 - Plugging in or removing a mouse, keyboard or tablet no longer deletes input devices that an application set up for
   itself. Window managers such as SonicDE's crashed on exit or restart because of it.
+- Applications no longer crash when an extra pointer and keyboard pair (an X master device) is removed, for example by a
+  virtual machine or by `xinput remove-master`. Before, every running Qt application crashed at once, which could end
+  the whole desktop session.
 - Animations use about half the processor time, because Qt windows that animate themselves now draw in step with your
   display, instead of drawing about two frames in three that it can't show. Windows built with Qt Widgets aren't
   affected, and neither are windows drawn by the graphics card, as Qt Quick windows usually are. If you need to, you can
diff --git a/src/plugins/platforms/xcb/qxcbconnection_xi2.cpp b/src/plugins/platforms/xcb/qxcbconnection_xi2.cpp
index 16a6cc7..3851cec 100644
--- a/src/plugins/platforms/xcb/qxcbconnection_xi2.cpp
+++ b/src/plugins/platforms/xcb/qxcbconnection_xi2.cpp
@@ -549,6 +549,11 @@ void QXcbConnection::xi2SetupDevices()
         m_xiSlavePointerIds.removeAll(id);
         m_touchDevices.remove(id);
     }
+    // A removed master takes its slaves, which are its children, with it.
+    const QList<const QInputDevice *> removed = previousDevices;
+    previousDevices.removeIf([&removed](const QInputDevice *dev) {
+        return removed.contains(qobject_cast<const QInputDevice *>(dev->parent()));
+    });
     qDeleteAll(previousDevices);
 
     if (m_xiMasterPointerIds.size() > 1)
diff --git a/tests/auto/inputdevices/tst_inputdevices.cpp b/tests/auto/inputdevices/tst_inputdevices.cpp
index 9ce345c..1a8d967 100644
--- a/tests/auto/inputdevices/tst_inputdevices.cpp
+++ b/tests/auto/inputdevices/tst_inputdevices.cpp
@@ -40,6 +40,34 @@ static void addMasterDevice(xcb_connection_t *connection, const QByteArray &name
     xcb_flush(connection);
 }
 
+// Removes a master pair again, as unplugging does; its slave devices float.
+static void removeMasterDevice(xcb_connection_t *connection, xcb_input_device_id_t masterPointer)
+{
+    xcb_input_remove_master_t remove = {};
+    remove.type = XCB_INPUT_HIERARCHY_CHANGE_TYPE_REMOVE_MASTER;
+    remove.len = sizeof(remove) / 4;
+    remove.deviceid = masterPointer;
+    remove.return_mode = XCB_INPUT_CHANGE_MODE_FLOAT;
+    xcb_input_xi_change_hierarchy(connection, 1, reinterpret_cast<const xcb_input_hierarchy_change_t *>(&remove));
+    xcb_flush(connection);
+}
+
+static QByteArray deviceNames()
+{
+    QStringList names;
+    for (const QInputDevice *dev : QInputDevice::devices())
+        names << dev->name();
+    return names.join(u", "_s).toUtf8();
+}
+
+static const QInputDevice *deviceNamed(const QString &name)
+{
+    const auto devices = QInputDevice::devices();
+    const auto it = std::find_if(devices.cbegin(), devices.cend(),
+                                 [&name](const QInputDevice *dev) { return dev->name().startsWith(name); });
+    return it == devices.cend() ? nullptr : *it;
+}
+
 void tst_InputDevices::hierarchyChangeKeepsForeignDevices()
 {
     auto *connection = static_cast<xcb_connection_t *>(
@@ -53,13 +81,20 @@ void tst_InputDevices::hierarchyChangeKeepsForeignDevices()
     QWindowSystemInterface::registerInputDevice(foreign);
 
     const QByteArray name = "qxlibre test " + QByteArray::number(QCoreApplication::applicationPid());
+    const QString pointerName = QString::fromLatin1(name) + u" pointer"_s;
     addMasterDevice(connection, name);
     // The plugin has handled the hierarchy event once it lists the new master.
-    QTRY_VERIFY(std::any_of(QInputDevice::devices().cbegin(), QInputDevice::devices().cend(),
-                            [&name](const QInputDevice *dev) { return dev->name().startsWith(QString::fromLatin1(name)); }));
+    QTRY_VERIFY2(deviceNamed(pointerName), deviceNames().constData());
 
     QVERIFY2(foreign, "the plugin deleted an input device it didn't create");
     QVERIFY(QInputDevice::devices().contains(foreign.data()));
+
+    // The removed masters and their slaves go together; the slaves are the masters' children.
+    removeMasterDevice(connection, deviceNamed(pointerName)->systemId());
+    QTRY_VERIFY(!deviceNamed(pointerName));
+    QVERIFY(std::none_of(QInputDevice::devices().cbegin(), QInputDevice::devices().cend(),
+                         [&name](const QInputDevice *dev) { return dev->name().startsWith(QString::fromLatin1(name)); }));
+    QVERIFY2(foreign, "the plugin deleted an input device it didn't create");
     delete foreign.data();
 }
 
