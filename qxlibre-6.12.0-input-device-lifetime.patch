 .../platforms/xcb/qxcbconnection_xi2.cpp      |  5 ++
 tests/auto/CMakeLists.txt                     |  1 +
 tests/auto/inputdevices/CMakeLists.txt        | 11 +++
 tests/auto/inputdevices/tst_inputdevices.cpp  | 82 +++++++++++++++++++
 5 files changed, 102 insertions(+), 1 deletion(-)
 create mode 100644 tests/auto/inputdevices/CMakeLists.txt
 create mode 100644 tests/auto/inputdevices/tst_inputdevices.cpp

